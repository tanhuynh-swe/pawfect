# Copy to .env and fill in. Never commit .env.

# Free: https://www.pexels.com/api/  (200 req/hour, no card)
PEXELS_API_KEY=

# Free: https://pixabay.com/api/docs/  (no card)
PIXABAY_API_KEY=

# Free, but not self-serve: email team@coverr.co describing the use case.
# Curated footage with written titles, so it matches queries well — but their
# terms ask for attribution with the Coverr logo, which the others do not.
COVERR_API_KEY=

# Required for `run.py auto` (script.mode: api). A few cents per video.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Email digest after every automated run.
# GMAIL_APP_PASSWORD is NOT your Gmail password — create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
GMAIL_ADDRESS=tanhuynhswe@gmail.com
GMAIL_APP_PASSWORD=
DIGEST_TO=tanhuynhswe@gmail.com

# Path to the OAuth client secret JSON you download from Google Cloud Console.
YOUTUBE_CLIENT_SECRET=./client_secret.json

# TikTok API credentials for auto-publishing shorts.
# Get these from https://developers.tiktok.com/app/<app-id>/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a Redirect URI registered on the TikTok app exactly.
TIKTOK_REDIRECT_URI=
